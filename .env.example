# Supabase Project Settings > API
# Local example: http://127.0.0.1:54321
# Production example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Project Settings > API > anon public key
# This key is safe to expose to the browser when RLS policies are correct.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Canonical app URL used for OAuth redirects, OGP, and shared URLs.
NEXT_PUBLIC_SITE_URL=https://ideahub.jp

# Do not add SUPABASE_SERVICE_ROLE_KEY to this frontend app.
